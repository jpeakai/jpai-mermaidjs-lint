    "md-default-fg-color--lightest": { "$type": "color", "$value": "#e5dee2" },
    "md-typeset-color": { "$type": "color", "$value": "#1c1a20" },
    "md-primary-fg-color": { "$type": "color", "$value": "#5c4295", "$description": "Synth Violet, day" },
