# Ignore all the children repos this top level orchestrator monorepo
# The point of this repo is a root node level perspective of the entire system.
# There are child orchestrator repos too that are responsible for their own domain
# Each node in the heirarchy is a git repo to implement change management processes.
jpai-*/
# python
.venv/
__pycache__/

# node
node_modules/

# build output, bundled at publish time
dist/

# docs site pages and snippets generated by scripts/build-site.ts
docs-site/docs/reference/rules.md
docs-site/docs/gallery/fixtures.md
docs-site/docs/gallery/examples.md
docs-site/snippets/

# pytest-xharness-eval build workspaces, session logs and report (make evals)
.xharness_eval_cache/
.pytest_cache/
