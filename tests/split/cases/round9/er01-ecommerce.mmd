%% source: https://mermaid.js.org/syntax/entityRelationshipDiagram.html (CUSTOMER/ORDER/LINE-ITEM example, extended)
%% kind: erDiagram e-commerce with identifying and non-identifying relationships
erDiagram
  CUSTOMER ||--o{ ORDER : places
  CUSTOMER ||--o{ ADDRESS : "ships to"
  CUSTOMER ||--o{ PAYMENT_METHOD : stores
  CUSTOMER ||--o| CART : owns
  CART ||--|{ CART_ITEM : contains
  CART_ITEM }o..|| PRODUCT_VARIANT : references
  ORDER ||--|{ ORDER_LINE : contains
  ORDER_LINE }o..|| PRODUCT_VARIANT : "sold as"
  ORDER ||--o{ SHIPMENT : "fulfilled by"
  SHIPMENT ||--|{ SHIPMENT_ITEM : packs
  SHIPMENT_ITEM }o..|| ORDER_LINE : covers
  SHIPMENT }o..|| CARRIER : "carried by"
  ORDER ||--o{ PAYMENT : "paid by"
  PAYMENT }o..|| PAYMENT_METHOD : uses
  PAYMENT ||--o{ REFUND : "refunded by"
  ORDER }o..o| COUPON : applies
  PRODUCT ||--|{ PRODUCT_VARIANT : "offered as"
  PRODUCT }o..|| BRAND : "made by"
  PRODUCT }o--o{ CATEGORY : "listed in"
  PRODUCT ||--o{ PRODUCT_IMAGE : shows
  PRODUCT ||--o{ REVIEW : receives
  CUSTOMER ||--o{ REVIEW : writes
  PRODUCT_VARIANT ||--o{ STOCK_LEVEL : "stocked as"
  WAREHOUSE ||--o{ STOCK_LEVEL : holds
  ORDER ||--o{ RETURN_REQUEST : "returned via"
  RETURN_REQUEST }o..|| ORDER_LINE : "for line"
  CUSTOMER {
    uuid id PK
    string email UK
    string first_name
    string last_name
    string phone
    boolean marketing_opt_in
    timestamp created_at
    timestamp last_login_at
  }
  ADDRESS {
    uuid id PK
    uuid customer_id FK
    string line1
    string line2
    string city
    string region
    string postal_code
    string country_code
    boolean is_default
  }
  PAYMENT_METHOD {
    uuid id PK
    uuid customer_id FK
    string provider
    string token
    string brand
    string last4
    int exp_month
    int exp_year
  }
  CART {
    uuid id PK
    uuid customer_id FK
    string currency
    timestamp updated_at
  }
  CART_ITEM {
    uuid cart_id PK,FK
    uuid variant_id PK,FK
    int quantity
    timestamp added_at
  }
  ORDER {
    uuid id PK
    string order_number UK
    uuid customer_id FK
    uuid shipping_address_id FK
    string status
    string currency
    decimal subtotal
    decimal tax_total
    decimal shipping_total
    decimal grand_total
    timestamp placed_at
  }
  ORDER_LINE {
    uuid order_id PK,FK
    int line_no PK
    uuid variant_id FK
    int quantity
    decimal unit_price
    decimal discount
  }
  SHIPMENT {
    uuid id PK
    uuid order_id FK
    uuid carrier_id FK
    string tracking_number
    string status
    timestamp shipped_at
    timestamp delivered_at
  }
  SHIPMENT_ITEM {
    uuid shipment_id PK,FK
    int line_no PK,FK
    int quantity
  }
  CARRIER {
    uuid id PK
    string name
    string tracking_url_template
  }
  PAYMENT {
    uuid id PK
    uuid order_id FK
    uuid payment_method_id FK
    decimal amount
    string status
    string provider_ref
    timestamp captured_at
  }
  REFUND {
    uuid id PK
    uuid payment_id FK
    decimal amount
    string reason
    timestamp refunded_at
  }
  COUPON {
    string code PK
    string kind
    decimal value
    timestamp valid_from
    timestamp valid_to
    int max_redemptions
  }
  PRODUCT {
    uuid id PK
    uuid brand_id FK
    string slug UK
    string title
    text description
    string status
  }
  PRODUCT_VARIANT {
    uuid id PK
    uuid product_id FK
    string sku UK
    string size
    string colour
    decimal price
    int weight_grams
  }
  BRAND {
    uuid id PK
    string name
    string country
  }
  CATEGORY {
    uuid id PK
    uuid parent_id FK
    string name
    string path
  }
  PRODUCT_IMAGE {
    uuid id PK
    uuid product_id FK
    string url
    int position
  }
  REVIEW {
    uuid id PK
    uuid product_id FK
    uuid customer_id FK
    int rating
    text body
    timestamp created_at
  }
  WAREHOUSE {
    uuid id PK
    string code UK
    string city
  }
  STOCK_LEVEL {
    uuid warehouse_id PK,FK
    uuid variant_id PK,FK
    int on_hand
    int reserved
  }
  RETURN_REQUEST {
    uuid id PK
    uuid order_id FK
    int line_no FK
    string reason
    string status
  }
