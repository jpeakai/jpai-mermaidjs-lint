{
  "name": "@jpeakai/mermaidjs-lint",
  "version": "0.7.2",
  "type": "module",
  "description": "Deterministic lint gates and verified fixers for Mermaid diagrams in markdown",
  "license": "MIT",
  "keywords": [
    "mermaid",
    "mermaidjs",
    "lint",
    "diagram",
    "markdown",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpeakai/jpai-mermaidjs-lint.git"
  },
  "homepage": "https://jpeakai.github.io/jpai-mermaidjs-lint/",
  "bugs": "https://github.com/jpeakai/jpai-mermaidjs-lint/issues",
  "packageManager": "bun@1.3.12",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "make check",
    "prepack": "make build"
  },
  "bin": {
    "mermaidjs-lint": "dist/bin.js"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "bun": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "dist",
    "examples"
  ],
  "dependencies": {
    "@mermaid-js/parser": "^1.1.0",
    "@types/mdast": "^4",
    "colorjs.io": "^0.6.1",
    "happy-dom": "^20.9.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@jpeakai/prose-gates": "^0.2.0",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
